# Copy to backend/.env for local development. Never commit the real .env.

# development | production (production refuses to start without the two secrets below)
APP_ENV=development

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Demo account used for login (there is no user database yet)
DEMO_USERNAME=johndoe
DEMO_PASSWORD=

# Comma-separated list of frontend URLs allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000

# Upload size limit in megabytes
MAX_FILE_SIZE_MB=10

# Optional: enables the VirusTotal hash lookup (only the SHA-256 is sent)
VT_API_KEY=

# Token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60
